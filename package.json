{
  "name": "fitsync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fitsync/web",
    "build": "npm run build --workspace @fitsync/web",
    "lint": "npm run lint --workspace @fitsync/web",
    "typecheck": "npm run typecheck --workspace @fitsync/web",
    "test": "npm run test --workspace @fitsync/web",
    "test:e2e": "npm run test:e2e --workspace @fitsync/web",
    "benchmark:ocr:generate": "npx --yes tsx@4.20.6 benchmark/ocr/src/cli.ts generate",
    "benchmark:ocr:validate": "npx --yes tsx@4.20.6 benchmark/ocr/src/cli.ts validate",
    "benchmark:ocr:run": "npx --yes tsx@4.20.6 benchmark/ocr/src/cli.ts run",
    "benchmark:ocr:report": "npx --yes tsx@4.20.6 benchmark/ocr/src/cli.ts report",
    "benchmark:ocr:test": "vitest run --config benchmark/ocr/vitest.config.mts",
    "benchmark:ocr:typecheck": "tsc --noEmit -p benchmark/ocr/tsconfig.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > apps/web/src/types/database.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
