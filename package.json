{
  "name": "fitsync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fitsync/web",
    "build": "npm run build --workspace @fitsync/web",
    "lint": "npm run lint --workspace @fitsync/web",
    "typecheck": "npm run typecheck --workspace @fitsync/web",
    "test": "npm run test --workspace @fitsync/web",
    "test:e2e": "npm run test:e2e --workspace @fitsync/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > apps/web/src/types/database.ts",
    "seed:oc2:plan": "node scripts/seed-oc2-demo.mjs",
    "seed:oc2:apply": "node scripts/seed-oc2-demo.mjs --apply",
    "seed:oc2:cloud": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-oc2-cloud.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
