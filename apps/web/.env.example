# Local Supabase endpoints and site URL
# Copy this file to apps/web/.env.local and fill in the values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Enable only after the chat migration and database/isolation acceptance pass
FITSYNC_CHAT_ENABLED=false

# Separate rollout gate for shared appointment create/read
FITSYNC_CALENDAR_ENABLED=false

# Enable only with the tested membership/note migration
FITSYNC_COACHING_CONTEXT_ENABLED=false
