# FitSync Android U-01 local debug configuration (loopback-only via USB adb reverse)
# Copy to mobile/.env.local and fill EXPO_PUBLIC_SUPABASE_ANON_KEY from local Supabase status.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or hosted/production URLs here.
# Before running on a physical USB Android device, forward local Supabase port 54321:
#   adb reverse tcp:54321 tcp:54321
#   adb reverse tcp:8081 tcp:8081

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
